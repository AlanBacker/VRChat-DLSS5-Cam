{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "VRChat DLSS5 Cam",
  "description": "A free Windows app that runs the VRChat camera, your photos and your videos through NVIDIA DLSS 5 and saves the result.",
